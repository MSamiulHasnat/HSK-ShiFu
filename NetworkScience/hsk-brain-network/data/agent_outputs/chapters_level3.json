{"level":3,
"chapters":{
 "1":{"title_zh": "周末你有什么打算", "title_en": "What's your plan for the weekend", "start_page": 17, "end_page": 26},
 "2":{"title_zh": "他什么时候回来", "title_en": "When will he come back", "start_page": 27, "end_page": 35},
 "3":{"title_zh": "桌子上放着很多饮料", "title_en": "There are plenty of drinks on the table", "start_page": 36, "end_page": 44},
 "4":{"title_zh": "她总是笑着跟客人说话", "title_en": "She always smiles when talking to customers", "start_page": 45, "end_page": 52},
 "5":{"title_zh": "我最近越来越胖了", "title_en": "I am getting fatter and fatter lately", "start_page": 53, "end_page": 61},
 "6":{"title_zh": "怎么突然找不到了", "title_en": "Why are they suddenly missing", "start_page": 62, "end_page": 70},
 "7":{"title_zh": "我跟她都认识五年了", "title_en": "I've known her for five years", "start_page": 71, "end_page": 79},
 "8":{"title_zh": "你去哪儿我就去哪儿", "title_en": "I'll go wherever you go", "start_page": 80, "end_page": 87},
 "9":{"title_zh": "她的汉语说得跟中国人一样好", "title_en": "She speaks Chinese like a native", "start_page": 88, "end_page": 96},
 "10":{"title_zh": "数学比历史难多了", "title_en": "Maths is much harder than history", "start_page": 97, "end_page": 105},
 "11":{"title_zh": "别忘了把空调关了", "title_en": "Don't forget to turn off the air conditioner", "start_page": 106, "end_page": 113},
 "12":{"title_zh": "把重要的东西放在我这儿吧", "title_en": "Leave the important items with me", "start_page": 114, "end_page": 122},
 "13":{"title_zh": "我是走回来的", "title_en": "I walked back", "start_page": 123, "end_page": 131},
 "14":{"title_zh": "你把水果拿过来", "title_en": "Please bring the fruit here", "start_page": 132, "end_page": 140},
 "15":{"title_zh": "其他都没什么问题", "title_en": "The rest of them are all OK", "start_page": 141, "end_page": 150},
 "16":{"title_zh": "我现在累得下了班就想睡觉", "title_en": "I am so tired that I want to do nothing but sleep after work", "start_page": 151, "end_page": 158},
 "17":{"title_zh": "谁都有办法看好你的\"病\"", "title_en": "Everybody is able to cure your \"disease\"", "start_page": 159, "end_page": 166},
 "18":{"title_zh": "我相信他们会同意的", "title_en": "I believe they'll agree", "start_page": 167, "end_page": 174},
 "19":{"title_zh": "你没看出来吗", "title_en": "Didn't you recognise him", "start_page": 175, "end_page": 183},
 "20":{"title_zh": "我被他影响了", "title_en": "I've been influenced by him", "start_page": 184, "end_page": 193}
},
